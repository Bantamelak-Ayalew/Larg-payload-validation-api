<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
      http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
      http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ===================== PROPERTIES CONFIG =========================== -->
    <configuration-properties file="config.properties" />

    <!-- Max payload size from external config -->
    <!-- Example in config.properties:
         max.size.bytes=10240
    -->

    <!-- ===================== HTTP LISTENER CONFIG ======================== -->
    <http:listener-config name="HTTP_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${http.port}" />
    </http:listener-config>

    <!-- ===================== GLOBAL ERROR HANDLER ======================== -->
    <error-handler name="GLOBAL_ERROR_HANDLER">

        <!-- Client-side bad request -->
        <on-error-propagate type="HTTP:BAD_REQUEST" logException="true">
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[
                    %dw 2.0
                    output application/json
                    ---
                    {
                        correlationId: vars.correlationId default "N/A",
                        errorType: error.errorType,
                        message: error.errorMessage,
                        category: "BAD_REQUEST",
                        timestamp: now()
                    }
                    ]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <!-- Generic catch-all -->
        <on-error-continue logException="true">
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[
                    %dw 2.0
                    output application/json
                    ---
                    {
                        correlationId: vars.correlationId default "N/A",
                        error: "INTERNAL_SERVER_ERROR",
                        message: error.errorMessage,
                        timestamp: now()
                    }
                    ]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </on-error-continue>

    </error-handler>

    <!-- ========================== MAIN FLOW ============================== -->

    <flow name="payload-validation-main-flow">

        <!-- Set correlation ID -->
        <set-variable variableName="correlationId" value="#[uuid()]" />

        <http:listener config-ref="HTTP_Listener_Config" path="/validate/payload" />

        <!-- ============================ START LOG =========================== -->
        <logger level="INFO" message='#[%dw 2.0
            output application/json
            ---
            {
                event: "START_FLOW",
                correlationId: vars.correlationId,
                flow: flow.name,
                timestamp: now(),
                receivedPayload: payload
            }
        ]'/>

        <!-- Preserve the original payload -->
        <set-variable variableName="originalPayload" value="#[payload]" />

        <!-- ===================== SIZE CALCULATION ========================== -->
        <ee:transform doc:name="Calculate Payload Size">
            <ee:message>
                <ee:set-payload><![CDATA[
                %dw 2.0
                output application/json
                var serialized = write(vars.originalPayload, "application/json")
                var sizeBytes = sizeOf(serialized)
                ---
                {
                    payload: vars.originalPayload,
                    sizeBytes: sizeBytes,
                    serialized: serialized
                }
                ]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="payloadSize">
                    <![CDATA[
                    %dw 2.0
                    output application/java
                    ---
                    sizeOf(write(vars.originalPayload, "application/json"))
                    ]]>
                </ee:set-variable>
            </ee:variables>
        </ee:transform>

        <!-- ========================== CHOICE LOGIC ========================= -->
        <choice>
            <when expression="#[vars.payloadSize > (p('max.size.bytes') as Number)]">
                
                <logger level="WARN" message='#[%dw 2.0
                    output application/json
                    ---
                    {
                        event: "LARGE_PAYLOAD",
                        correlationId: vars.correlationId,
                        sizeBytes: vars.payloadSize,
                        maxAllowed: p("max.size.bytes")
                    }
                ]'/>

                <ee:transform doc:name="Large Payload Response">
                    <ee:message>
                        <ee:set-payload><![CDATA[
                        %dw 2.0
                        output application/json
                        ---
                        {
                            message: "Large payload uploaded",
                            sizeBytes: vars.payloadSize,
                            maxAllowed: p("max.size.bytes"),
                            correlationId: vars.correlationId
                        }
                        ]]></ee:set-payload>
                    </ee:message>
                </ee:transform>

            </when>

            <otherwise>

                <logger level="INFO" message='#[%dw 2.0
                    output application/json
                    ---
                    {
                        event: "NORMAL_PAYLOAD",
                        sizeBytes: vars.payloadSize,
                        correlationId: vars.correlationId
                    }
                ]'/>

                <ee:transform doc:name="Normal Payload Response">
                    <ee:message>
                        <ee:set-payload><![CDATA[
                        %dw 2.0
                        output application/json
                        ---
                        {
                            message: "Normal payload",
                            sizeBytes: vars.payloadSize,
                            payload: vars.originalPayload,
                            correlationId: vars.correlationId
                        }
                        ]]></ee:set-payload>
                    </ee:message>
                </ee:transform>

            </otherwise>
        </choice>

        <!-- ============================= END LOG =========================== -->
        <logger level="INFO" message='#[%dw 2.0
            output application/json
            ---
            {
                event: "END_FLOW",
                correlationId: vars.correlationId,
                finalPayload: payload,
                timestamp: now()
            }
        ]'/>

    </flow>

</mule>
